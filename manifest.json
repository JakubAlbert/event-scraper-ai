{
  "manifest_version": 3,
  "name": "Event Scraper AI",
  "version": "2.1.1",
  "minimum_chrome_version": "110",
  "description": "Rozšírenie na extrahovanie údajov o podujatiach z webových stránok.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://maps.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Otvorí popup okno pre extrakciu dát"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["paste.js"]
    }
  ]
}
